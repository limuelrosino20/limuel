import React, { useState, useEffect } from 'react';

import {
  View,
  Text,
  TextInput,
  TouchableOpacity,
  FlatList,
  StyleSheet,
  Alert,
  ActivityIndicator,
} from 'react-native';

import AsyncStorage from '@react-native-async-storage/async-storage';

// ==========================================
// 1. STORAGE KEY
// ==========================================

const STORAGE_KEY = '@my_notes';

// ==========================================
// 2. MAIN APP COMPONENT
// ==========================================

export default function App() {
  const [notes, setNotes] = useState([]);
  const [noteText, setNoteText] = useState('');
  const [editingId, setEditingId] = useState(null);

  const [isLoading, setIsLoading] = useState(true);

  // ==========================================
  // 3. READ - LOAD NOTES FROM STORAGE
  // ==========================================

  useEffect(() => {
    loadNotes();
  }, []);

  const loadNotes = async () => {
    try {
      const savedNotes = await AsyncStorage.getItem(STORAGE_KEY);

      if (savedNotes !== null) {
        const parsedNotes = JSON.parse(savedNotes);
        setNotes(parsedNotes);
      }
    } catch (error) {
      console.error('Error loading notes:', error);
      Alert.alert('Error', 'Failed to load saved notes.');
    } finally {
      setIsLoading(false);
    }
  };

  // ==========================================
  // 4. SAVE NOTES TO ASYNC STORAGE
  // ==========================================

  const saveNotes = async (updatedNotes) => {
    try {
      const jsonValue = JSON.stringify(updatedNotes);

      await AsyncStorage.setItem(STORAGE_KEY, jsonValue);

      setNotes(updatedNotes);
    } catch (error) {
      console.error('Error saving notes:', error);
      Alert.alert('Error', 'Failed to save notes.');
    }
  };

  // ==========================================
  // 5. CREATE AND UPDATE NOTES
  // ==========================================

  const handleSaveNote = async () => {
    const trimmedText = noteText.trim();

    if (!trimmedText) {
      Alert.alert('Empty Note', 'Please enter a note first.');
      return;
    }

    let updatedNotes;

    if (editingId !== null) {
      // UPDATE EXISTING NOTE
      updatedNotes = notes.map((note) =>
        note.id === editingId
          ? { ...note, text: trimmedText }
          : note
      );
    } else {
      // CREATE NEW NOTE
      const newNote = {
        id: Date.now().toString(),
        text: trimmedText,
      };

      updatedNotes = [...notes, newNote];
    }

    await saveNotes(updatedNotes);

    setNoteText('');
    setEditingId(null);
  };

  // ==========================================
  // 6. EDIT NOTE
  // ==========================================

  const handleEditNote = (note) => {
    setNoteText(note.text);
    setEditingId(note.id);
  };

  // ==========================================
  // 7. DELETE NOTE
  // ==========================================

  const handleDeleteNote = (id) => {
    Alert.alert(
      'Delete Note',
      'Are you sure you want to delete this note?',
      [
        {
          text: 'Cancel',
          style: 'cancel',
        },
        {
          text: 'Delete',
          style: 'destructive',
          onPress: async () => {
            const updatedNotes = notes.filter(
              (note) => note.id !== id
            );

            await saveNotes(updatedNotes);

            if (editingId === id) {
              setNoteText('');
              setEditingId(null);
            }
          },
        },
      ]
    );
  };

  // ==========================================
  // 8. CANCEL EDITING
  // ==========================================

  const handleCancelEdit = () => {
    setNoteText('');
    setEditingId(null);
  };

  // ==========================================
  // 9. LOADING SCREEN
  // ==========================================

  if (isLoading) {
    return (
      <View style={styles.loadingContainer}>
        <ActivityIndicator size="large" color="#2563EB" />
        <Text style={styles.loadingText}>
          Loading your notes...
        </Text>
      </View>
    );
  }

  // ==========================================
  // 10. MAIN USER INTERFACE
  // ==========================================

  return (
    <View style={styles.container}>

      <Text style={styles.heading}>My Notes</Text>

      <Text style={styles.subtitle}>
        Save your thoughts and important tasks.
      </Text>

      {/* NOTE INPUT */}

      <TextInput
        style={styles.input}
        placeholder="Write your note here..."
        placeholderTextColor="#999"
        value={noteText}
        onChangeText={setNoteText}
        multiline
      />

      {/* SAVE / UPDATE BUTTON */}

      <TouchableOpacity
        style={styles.saveButton}
        onPress={handleSaveNote}
      >
        <Text style={styles.saveButtonText}>
          {editingId !== null ? 'Update Note' : 'Add Note'}
        </Text>
      </To
