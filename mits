// CLASS + CONSTRUCTOR + METHODS
class Person {
  constructor(name, age) {
    this.name = name;
    this.age = age;
  }

  introduce() {
    console.log("Hello, I am " + this.name);
  }

  study() {
    console.log(this.name + " is studying JavaScript.");
  }

  greet() {
    console.log("Welcome to JavaScript!");
  }

  getInfo() {
    return this.name + " - " + this.age;
  }

  birthday() {
    this.age++;
    console.log(this.name + " is now " + this.age);
  }
}

// ENCAPSULATION
class BankAccount {
  #balance = 1000;

  deposit(amount) {
    this.#balance += amount;
  }

  getBalance() {
    return this.#balance;
  }
}

// ABSTRACTION
class Animal {
  speak() {
    console.log("Animals make sounds.");
  }
}

// INHERITANCE + POLYMORPHISM
class Dog extends Animal {
  speak() {
    console.log("Dog says arf!");
  }
}

// OBJECTS
